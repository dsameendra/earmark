<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xml:lang="en">
  <head>
    <metadata>
      <ttm:title>Team Sync</ttm:title>
      <ttm:agent xml:id="spk-1" type="person"><ttm:name type="full">Alice</ttm:name></ttm:agent>
      <ttm:agent xml:id="spk-2" type="person"><ttm:name type="full">Dumindu</ttm:name></ttm:agent>
    </metadata>
    <styling>
      <style xml:id="default" tts:textAlign="center"/>
    </styling>
  </head>
  <body>
    <div>
      <p begin="00:00:00.000" end="00:00:01.120" xml:lang="en" ttm:agent="spk-1">Good morning<br/>everyone.</p>
      <p begin="00:00:01.200" end="00:00:03.200" xml:lang="en" ttm:agent="spk-1">Let's start the<br/>weekly sync.</p>
      <p begin="00:00:03.500" end="00:00:06.000" xml:lang="si" ttm:agent="spk-2">ආයුබෝවන්, අද රැස්වීමේ කාර්ය<br/>සූචිය බලමු.</p>
      <p begin="00:00:06.200" end="00:00:08.000" xml:lang="si" ttm:agent="spk-2">මම හොඳින්, ස්තුතියි.</p>
      <p begin="00:00:09.500" end="00:00:10.744" xml:lang="en" ttm:agent="spk-1">The quarterly<br/>numbers look good,</p>
      <p begin="00:00:10.824" end="00:00:12.596" xml:lang="en" ttm:agent="spk-1">but we need to<br/>improve the Sinhala</p>
      <p begin="00:00:12.676" end="00:00:13.126" xml:lang="en" ttm:agent="spk-1">transcription<br/>accuracy,</p>
      <p begin="00:00:13.206" end="00:00:14.206" xml:lang="en" ttm:agent="spk-1">especially for<br/>names.</p>
      <p begin="00:00:14.500" end="00:00:16.541" xml:lang="en" ttm:agent="spk-2">Agreed. I'll review<br/>the rules with Zoom</p>
      <p begin="00:00:16.621" end="00:00:18.000" xml:lang="en" ttm:agent="spk-2">&amp; Teams &lt;beta&gt; next<br/>week.</p>
      <p begin="00:00:25.000" end="00:00:27.020" xml:lang="en" ttm:agent="spk-1">After a long pause:<br/>a quote &quot;hello&quot;,</p>
      <p begin="00:00:27.100" end="00:00:28.100" xml:lang="en" ttm:agent="spk-1">and a comma.</p>
    </div>
  </body>
</tt>
